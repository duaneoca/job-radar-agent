# ── Email provider ────────────────────────────────────────────
EMAIL_PROVIDER=proton            # proton | gmail | imap   (imap = e.g. Yahoo, see below)
EMAIL_READER_TRANSPORT=direct    # direct (in-process) | mcp (consume the Email Reader MCP over stdio)
# NOTE (Proton Bridge): Bridge namespaces user folders under "Folders/" and keeps the exact display
# name. "Hire Duane" in the Proton app is "Folders/Hire Duane" over IMAP. Quote it if it has spaces.
EMAIL_ROOT_FOLDER=Folders/Hire Duane
EMAIL_FOLDER_POSTINGS=Postings       # the agent reads UNREAD mail here (your mail filter fills it)
EMAIL_FOLDER_UNPROCESSED=Unprocessed # emails the agent couldn't verify are moved here
# EMAIL_FOLDER_INTERACTION / EMAIL_FOLDER_SOCIAL are not used by V2

# Proton Bridge (runs natively on this machine)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_IMAP_USER=
PROTON_IMAP_PASSWORD=            # Bridge-specific password (NOT your Proton login password)

# Generic IMAP (EMAIL_PROVIDER=imap). Yahoo: imap.mail.yahoo.com, port 993, and an APP password
# (Yahoo Account Security → Generate app password), never your login password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# ── Job Radar (write-back API) ────────────────────────────────
JOBRADAR_API_URL=https://job-radar.net/api
AGENT_API_KEY=                   # generate in Job Radar → Settings → Email Agent (see DEPLOYMENT.md §3)

# ── LLM (BYOK) ────────────────────────────────────────────────
# LOCAL self-host uses THESE keys directly (the agent never calls /agent/config — H6a).
# (Cloud users' keys live in their Job Radar account instead; not used here.)
LLM_PROVIDER=anthropic           # anthropic | openai | google | groq
LLM_MODEL=claude-haiku-4-5       # or a full LiteLLM model string
LLM_API_KEY=                     # your own provider key
LLM_TIMEOUT_SECONDS=25           # per-call timeout; tight so a stalled call fails fast + retries

# ── Retention: move mail older than N days (read or unread; NOT starred) to Trash ──
# Social and Postings only (Interaction / Unprocessed are never touched). 0 = off. Star a message to keep it.
# Proton: enable Settings → Messages → "Auto-delete unwanted messages" so Trash empties after 30 days.
RETENTION_SOCIAL_DAYS=0
RETENTION_POSTINGS_DAYS=0
RETENTION_MAX_PER_RUN=200

# ── Sorter (Jev decision model, TypeSafe AI) — system-wide key ──
# When enabled, each run first sorts UNREAD mail in EMAIL_ROOT_FOLDER into Interaction / Postings /
# Social / Unprocessed (Interaction mail is also written to Job Radar's inbox, with a recruiter card).
SORTER_ENABLED=false
TYPESAFE_API_KEY=                # console.typesafe.ai
JEV_MODEL=jev-latest
SORTER_MIN_CONFIDENCE=0.85       # below this → Unprocessed (tune with scripts/eval_sorter.py)
SORTER_MIN_MARGIN=0.30           # top-vs-runner-up folder probability gap required to route
BULK_RECRUITER_DOMAINS=          # recruiter mail from these senders → Postings, not Interaction (none by default)

# ── Sender policy (checked before any LLM call) ───────────────
# Comma-separated sender domains; subdomains match (notifications.monster.com ⊂ monster.com).
# Leave the value EMPTY to accept any sender.
ALLOWED_SENDER_DOMAINS=linkedin.com,glassdoor.com,monster.com,indeed.com,dice.com,builtin.com,trueup.io,jobot.com,jobright.ai
REQUIRE_SENDER_AUTH=true          # require dmarc=pass from the receiving mail server
TRUSTED_AUTHSERV_IDS=mail.protonmail.ch,mx.google.com

# ── Results ───────────────────────────────────────────────────
ZERO_POSTINGS_ACTION=mark_read    # email with no job postings: mark_read | unprocessed
DEDUP_WINDOW_DAYS=30              # skip postings seen within this many days (0 = off)

# ── Langfuse (optional — LLM tracing) ─────────────────────────
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Notifications (optional) ──────────────────────────────────
NOTIFIER=slack                   # slack | telegram | discord | null
SLACK_BOT_TOKEN=
SLACK_USER_CHANNEL=              # your job-activity channel (invite the bot to it)
SLACK_ADMIN_CHANNEL=            # optional ops/error channel; blank = falls back to the user channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
DISCORD_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
# signal | whatsapp | bluebubbles are stubs (require a relay/bridge) — not implemented

# ── Run controls / guardrails ─────────────────────────────────
MAX_EMAIL_AGE_DAYS=14            # ignore unread mail older than this (backlog control; 0 = no cutoff)
MAX_EMAILS_PER_RUN=25            # cap per run, newest-first (keeps each run quick; drains backlog over runs)
DAILY_SPEND_CEILING_USD=5.00     # per-day LLM spend cap on your key; 0 = disabled
POLL_INTERVAL_SECONDS=900        # only for `run` loop-mode; launchd uses the plist's StartInterval
